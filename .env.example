# ─────────────────────────────────────────────────────────────
# Variables de entorno — Sistema de Reservas Deportivas
# Copia este archivo como .env.local (desarrollo) y configura las
# mismas variables en el panel de Vercel (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Supabase PostgreSQL) ──────────────────────
# Pooler (puerto 6543, pgbouncer) — usado por la app en runtime
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) — usado por Prisma para migraciones
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ── NextAuth (autenticación web + JWT móvil) ─────────────────
# Genera uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secreto-fuerte-de-32-bytes"
# URL pública de producción (la que te da Vercel)
NEXTAUTH_URL="https://reserva-instalaciones.vercel.app"

# ── URL base de la app (para enlaces en emails y QR) ─────────
APP_URL="https://reserva-instalaciones.vercel.app"

# ── Emails transaccionales (Resend) ──────────────────────────
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXX"
# Solo en desarrollo: redirige todos los emails a esta dirección
# EMAIL_REDIRECCION_DEV="tu-email@ejemplo.com"

# ── Notificaciones Web Push (VAPID) ──────────────────────────
# Genera un par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BXXXXXXXXXXXXXXXXXXXX"
VAPID_PRIVATE_KEY="XXXXXXXXXXXXXXXXXXXX"
VAPID_EMAIL="tu-email@ejemplo.com"

# ── Cron jobs (recordatorios de reserva) ─────────────────────
# Vercel envía este valor como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="genera-otro-secreto-aleatorio"

# ── Almacenamiento de avatares (Cloudflare R2) — OPCIONAL ─────
# Si no se configuran, los avatares usan un placeholder con iniciales.
# R2_ACCOUNT_ID="xxxxxxxx"
# R2_ACCESS_KEY_ID="xxxxxxxx"
# R2_SECRET_ACCESS_KEY="xxxxxxxx"
# NEXT_PUBLIC_R2_PUBLIC_URL="https://tu-bucket.r2.dev"
